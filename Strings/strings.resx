  <data name="pmdorand:config.bool" xml:space="preserve"><value>Boolean</value></data>
  <data name="pmdorand/documentation:config.bool">
    <value>
      Represents a boolean value, on or off. Often used to enable or disable certain features.
      Some boolean values support enabledness and can be set to "Dynamic" when selected. This makes the randomizer roll whether it is enabled or disabled for the entire generation.
    </value>
  </data>

